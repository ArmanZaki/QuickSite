{
  "name": "quicksite-backend",
  "version": "1.0.0",
  "description": "QuickSite backend (Node.js, Express, PostgreSQL, Sequelize)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "sequelize-cli db:migrate --env development --config ./config/config.js",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --env development --config ./config/config.js",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all --env development --config ./config/config.js",
    "db:seed": "sequelize-cli db:seed:all --env development --config ./config/config.js",
    "db:seed:undo": "sequelize-cli db:seed:undo:all --env development --config ./config/config.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sequelize-cli": "^6.6.2"
  }
}
