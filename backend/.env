# QuickSite Backend Environment Variables
NODE_ENV=development
PORT=4000

# Database (choose DATABASE_URL or individual parts)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quicksite_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quicksite_dev
DB_USER=postgres
DB_PASS=postgres

# JWT
JWT_SECRET=supersecret_jwt_key_change_me
JWT_EXPIRES_IN=7d

# Email (mocked for now)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=user@example.com
EMAIL_PASS=password
EMAIL_FROM="QuickSite <noreply@quicksite.local>"

# OTP
OTP_TTL_SECONDS=600
